{
  "name": "svn-browser",
  "version": "1.0.2",
  "description": "A lightweight Electron browser for multiple SVN repositories.",
  "main": "src/main.js",
  "scripts": {
    "start": "node scripts/start.js",
    "test": "node --test",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^37.10.3",
    "electron-builder": "^26.15.2"
  },
  "build": {
    "appId": "com.local.svnbrowser",
    "productName": "SVN Browser",
    "files": [
      "src/**/*",
      "scripts/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/svn",
        "to": "svn",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
